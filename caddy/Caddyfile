# Home — Landing page / directory of homelab endpoints
home.lan.rpamplona.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    root * /srv/landing
    file_server
}

# Vaultwarden — Password manager (Bitwarden-compatible) on :8080
vault.lan.rpamplona.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy localhost:8080
}

# Syncthing — Continuous peer-to-peer file synchronization on :8384
sync.lan.rpamplona.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy localhost:8384
}

# Navidrome — Self-hosted music streaming server (Subsonic-compatible) on :4533
music.lan.rpamplona.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy localhost:4533
}

# Radicale — Lightweight CalDAV/CardDAV calendar & contacts server on :5232
cal.lan.rpamplona.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy localhost:5232 {
        header_up X-Forwarded-Host cal.lan.rpamplona.com
        header_up X-Forwarded-Port 5232
    }
}

