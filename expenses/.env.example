# Producción (esta máquina)
# Copiar a .env y cambiar los secretos.

POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=55432

DATABASE_URL=postgresql+psycopg://expenses:change-me@db:5432/expenses

SESSION_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=https://expenses.lan.rpamplona.com
FRONTEND_ORIGINS=https://expenses.lan.rpamplona.com,https://expenses.rpamplona.com
REGISTRATION_EMAIL_WHITELIST=

# El frontend deriva la URL de la API a partir del hostname de acceso
# (expenses.lan.rpamplona.com -> expenses-api.lan.rpamplona.com,
#  expenses.rpamplona.com      -> expenses-api.rpamplona.com), por lo que
# ya no es necesario inyectar VITE_API_URL en el build.
